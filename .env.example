# ============================================================
# Variáveis de ambiente — KakauITSM
# Copie para .env e preencha todos os valores antes de iniciar
# NUNCA commite o .env no repositório
# ============================================================

# Ambiente: development | production
NODE_ENV=

# URL base pública da aplicação (sem barra no final)
# Usado em callbackURLs OAuth e links de email
BASE_URL=

# Segredo da sessão — mínimo 32 caracteres, gerado aleatoriamente
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Banco de dados PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
DB_SSL=

# Email do administrador — recebe notificações de novos clientes e chamados
ADMIN_EMAIL=

# AWS S3 — armazenamento de arquivos
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# OAuth Google (admin + clientes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Microsoft (clientes + NOVO: admin)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Domínios autorizados para login no painel admin
# Durante a migração: inclua ambos separados por vírgula
# Após migração completa: remova kakautech.com
ADMIN_ALLOWED_DOMAINS=

# Configurações de email (SMTP)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

GMAIL_SMTP_USER=
GMAIL_SMTP_CLIENT_ID=
GMAIL_SMTP_CLIENT_SECRET=
GMAIL_SMTP_REFRESH_TOKEN=

# Porta do servidor (padrão: 5000)
PORT=5000
