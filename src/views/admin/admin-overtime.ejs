<%
const MONTH_NAMES = [
  "Janeiro","Fevereiro","Março","Abril","Maio","Junho",
  "Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"
];
const prevMonth = month === 1 ? 12 : month - 1;
const prevYear  = month === 1 ? year - 1 : year;
const nextMonth = month === 12 ? 1 : month + 1;
const nextYear  = month === 12 ? year + 1 : year;
%>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
  <div>
    <h1 style="font-size:22px;font-weight:700;margin:0;">⏱ Horas Extras</h1>
    <p style="font-size:13px;color:var(--text-muted,#6c757d);margin-top:4px;">Controle de horas extras por funcionário</p>
  </div>

  <div style="display:flex;align-items:center;gap:8px;">
    <a href="/admin/overtime?year=<%= prevYear %>&month=<%= prevMonth %>"
       style="padding:6px 14px;border-radius:8px;border:1.5px solid var(--border-color,#dee2e6);text-decoration:none;color:inherit;font-size:13px;">‹</a>
    <span style="font-weight:600;font-size:14px;min-width:145px;text-align:center;">
      <%= MONTH_NAMES[month-1] %> de <%= year %>
    </span>
    <a href="/admin/overtime?year=<%= nextYear %>&month=<%= nextMonth %>"
       style="padding:6px 14px;border-radius:8px;border:1.5px solid var(--border-color,#dee2e6);text-decoration:none;color:inherit;font-size:13px;">›</a>

    <button onclick="syncHolidays(<%= year %>)"
      style="padding:8px 16px;border-radius:8px;background:#1187BD;color:#fff;border:none;font-size:13px;font-weight:600;cursor:pointer;">
      🗓 Sincronizar Feriados
    </button>
  </div>
</div>

<% if (summary.length === 0) { %>
  <div style="text-align:center;padding:60px 0;color:var(--text-muted,#6c757d);">
    <div style="font-size:48px;margin-bottom:12px;">📋</div>
    <p style="font-size:15px;">Nenhuma hora extra registrada em <%= MONTH_NAMES[month-1] %> de <%= year %>.</p>
  </div>
<% } else { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;">
    <% summary.forEach(function(item) { %>
    <div style="background:var(--bg-card,#fff);border-radius:12px;border:1px solid var(--border-color,#e9ecef);padding:20px;box-shadow:0 1px 4px rgba(0,0,0,.06);">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
        <div style="width:40px;height:40px;border-radius:50%;background:#1187BD;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;flex-shrink:0;">
          <%= item.user ? item.user.name.charAt(0).toUpperCase() : '?' %>
        </div>
        <div>
          <div style="font-weight:600;font-size:15px;"><%= item.user ? item.user.name : 'Desconhecido' %></div>
          <div style="font-size:12px;color:var(--text-muted,#6c757d);"><%= item.records.length %> registro(s)</div>
        </div>
        <div style="margin-left:auto;text-align:right;">
          <div style="font-size:22px;font-weight:700;color:#1187BD;font-variant-numeric:tabular-nums;"><%= item.total_formatted %></div>
          <div style="font-size:11px;color:var(--text-muted,#6c757d);">hrs extras</div>
        </div>
      </div>
      <a href="/admin/overtime/user/<%= item.user ? item.user.id : '' %>?year=<%= year %>&month=<%= month %>"
         style="display:block;text-align:center;padding:8px;border-radius:8px;background:rgba(17,135,189,.12);color:#1187BD;text-decoration:none;font-size:13px;font-weight:600;border:1.5px solid rgba(17,135,189,.25);">
        Ver detalhes
      </a>
    </div>
    <% }); %>
  </div>
<% } %>

<script>
async function syncHolidays(year) {
  const btn = event.target;
  btn.disabled = true;
  btn.textContent = 'Sincronizando...';
  try {
    const res = await fetch('/api/admin/overtime/holidays/sync', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ year }),
    });
    const data = await res.json();
    alert(data.message || 'Feriados sincronizados!');
  } catch(e) {
    alert('Erro ao sincronizar feriados.');
  } finally {
    btn.disabled = false;
    btn.textContent = '🗓 Sincronizar Feriados';
  }
}
</script>
