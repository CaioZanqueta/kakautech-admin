<%
  var pageTitle = 'Dashboard'
  var activeMenu = 'dashboard'
%>

<div class="dashboard-header">
  <h2>Bem-vindo(a), <%= typeof adminUser !== 'undefined' ? adminUser.name.split(' ')[0] : '' %> 👋</h2>
  <p>Acompanhe seus projetos, tarefas e chamados em tempo real</p>
</div>

<div id="dashboard-error" class="alert alert-error" style="display:none;"></div>
<div id="stats-container" class="stats-row"></div>

<div class="cards-row">
  <div class="card">
    <h3>📋 Tarefas por Status</h3>
    <div id="tasks-chart" style="min-height: 280px; display: flex; align-items: center; justify-content: center;">
      <p style="color: var(--gray-500);">Carregando...</p>
    </div>
  </div>
  <div class="card">
    <h3>🎫 Chamados por Status</h3>
    <div id="tickets-chart" style="min-height: 280px; display: flex; align-items: center; justify-content: center;">
      <p style="color: var(--gray-500);">Carregando...</p>
    </div>
  </div>
</div>

<script src="https://www.gstatic.com/charts/loader.js"></script>
<script>
  function setDashboardError(message) {
    var errorElement = document.getElementById('dashboard-error');
    errorElement.textContent = message;
    errorElement.style.display = 'flex';
  }

  function renderStatusFallback(containerId, byStatus, labels, emptyText, linkUrl) {
    var element = document.getElementById(containerId);
    var entries = Object.entries(byStatus || {}).filter(function(entry) { return Number(entry[1]) > 0; });
    if (!entries.length) {
      element.innerHTML = '<div class="empty-state"><div class="empty-icon">📭</div><p>' + emptyText + '</p></div>';
      return;
    }
    element.style.display = 'block';
    element.innerHTML = entries.map(function(entry) {
      return '<a href="' + linkUrl + '?view=list&filter.status=' + encodeURIComponent(entry[0]) + '" class="detail-row" style="text-decoration:none;">' +
        '<span class="detail-label">' + (labels[entry[0]] || entry[0]) + '</span>' +
        '<strong class="detail-value">' + Number(entry[1]) + '</strong></a>';
    }).join('');
  }

  function drawDonutChart(containerId, byStatus, labels, colors, emptyText, linkUrl) {
    var element = document.getElementById(containerId);
    var entries = Object.entries(byStatus || {}).filter(function(entry) { return Number(entry[1]) > 0; });
    if (!entries.length) {
      element.innerHTML = '<div class="empty-state"><div class="empty-icon">📭</div><p>' + emptyText + '</p></div>';
      return;
    }
    if (!window.google || !google.visualization) {
      renderStatusFallback(containerId, byStatus, labels, emptyText, linkUrl);
      return;
    }
    var chartData = [['Status', 'Quantidade']];
    entries.forEach(function(entry) {
      chartData.push([labels[entry[0]] || entry[0], Number(entry[1])]);
    });
    var textColor = window.getComputedStyle(document.body).getPropertyValue('--text-main').trim() || '#212529';
    var dataTable = google.visualization.arrayToDataTable(chartData);
    var chart = new google.visualization.PieChart(element);
    var options = {
      pieHole: 0.55,
      pieSliceText: 'value',
      legend: { position: 'bottom', textStyle: { fontSize: 12, color: textColor } },
      chartArea: { width: '90%', height: '70%' },
      colors: colors,
      pieSliceBorderColor: 'transparent',
      fontName: 'Inter',
      tooltip: { textStyle: { fontSize: 13 } },
      backgroundColor: 'transparent'
    };
    chart.draw(dataTable, options);
    element.style.cursor = 'pointer';
    element.addEventListener('click', function() { window.location.href = linkUrl; });
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() { chart.draw(dataTable, options); }, 120);
    });
    var observer = new MutationObserver(function() {
      options.legend.textStyle.color = window.getComputedStyle(document.body).getPropertyValue('--text-main').trim() || '#212529';
      chart.draw(dataTable, options);
    });
    observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
  }

  async function loadDashboard() {
    try {
      var response = await fetch('/admin/api/dashboard', { headers: { Accept: 'application/json' } });
      if (!response.ok) {
        var errorData = await response.json().catch(function() { return {}; });
        throw new Error(errorData.message || ('Falha HTTP ' + response.status));
      }
      var data = await response.json();
      if (!data.tasks || !data.tickets) throw new Error('Resposta do dashboard inválida.');
      var cards = [
        { label: 'Total de Tarefas', value: data.tasks.total || 0, cls: 'primary' },
        { label: 'Total de Chamados', value: data.tickets.total || 0, cls: 'primary' },
        { label: 'Chamados em Aberto', value: (data.tickets.byStatus.open || 0) + (data.tickets.byStatus.pending || 0), cls: 'warning' },
        { label: 'Concluídos', value: data.tasks.byStatus.done || 0, cls: 'success' }
      ];
      document.getElementById('stats-container').innerHTML = cards.map(function(card) {
        return '<div class="stat-card"><div class="stat-label">' + card.label + '</div><div class="stat-value ' + card.cls + '">' + card.value + '</div></div>';
      }).join('');
      var taskLabels = { backlog: 'Backlog', doing: 'Em Execução', done: 'Concluído' };
      var ticketLabels = { open: 'Aberto', pending: 'Pendente', in_progress: 'Em Andamento', closed: 'Fechado' };
      drawDonutChart('tasks-chart', data.tasks.byStatus, taskLabels, ['#1187BD', '#f5a623', '#2bb673'], 'Sem tarefas', '/admin/resources/tasks');
      drawDonutChart('tickets-chart', data.tickets.byStatus, ticketLabels, ['#1187BD', '#f5a623', '#6c63ff', '#2bb673'], 'Sem chamados', '/admin/resources/tickets');
    } catch (error) {
      console.error('Dashboard error:', error);
      setDashboardError('Não foi possível carregar o dashboard: ' + error.message);
      document.getElementById('stats-container').innerHTML = '';
      document.getElementById('tasks-chart').innerHTML = '<p style="color:var(--danger)">Erro ao carregar dados das tarefas.</p>';
      document.getElementById('tickets-chart').innerHTML = '<p style="color:var(--danger)">Erro ao carregar dados dos chamados.</p>';
    }
  }

  if (window.google && google.charts) {
    google.charts.load('current', { packages: ['corechart'] });
    google.charts.setOnLoadCallback(loadDashboard);
    setTimeout(function() {
      if (!document.getElementById('stats-container').children.length) loadDashboard();
    }, 3000);
  } else {
    loadDashboard();
  }
</script>
