<%
const MONTH_NAMES = [
  "Janeiro","Fevereiro","Março","Abril","Maio","Junho",
  "Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"
];
const WEEK_DAYS = ["dom","seg","ter","qua","qui","sex","sáb"];

function fmtDate(d) {
  const dt = new Date(d);
  return `${String(dt.getDate()).padStart(2,'0')}/${String(dt.getMonth()+1).padStart(2,'0')}`;
}
function fmtTime(d) {
  const dt = new Date(d);
  return `${String(dt.getHours()).padStart(2,'0')}:${String(dt.getMinutes()).padStart(2,'0')}`;
}
function weekDay(d) { return WEEK_DAYS[new Date(d).getDay()]; }

const prevMonth = month === 1 ? 12 : month - 1;
const prevYear  = month === 1 ? year - 1 : year;
const nextMonth = month === 12 ? 1 : month + 1;
const nextYear  = month === 12 ? year + 1 : year;
%>

<!-- Cabeçalho -->
<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
  <div>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin/overtime?year=<%= year %>&month=<%= month %>"
         style="font-size:13px;color:#1187BD;text-decoration:none;">← Voltar</a>
    <% } %>
    <h1 style="font-size:22px;font-weight:700;margin:4px 0 0;">
      ⏱ Horas Extras — <%= targetUser.name %>
    </h1>
    <p style="font-size:13px;color:var(--text-muted,#6c757d);margin-top:2px;">
      Período: <%= MONTH_NAMES[month-1] %> de <%= year %>
    </p>
  </div>

  <div style="display:flex;align-items:center;gap:8px;">
    <a href="/admin/overtime/user/<%= targetUser.id %>?year=<%= prevYear %>&month=<%= prevMonth %>"
       style="padding:6px 14px;border-radius:8px;border:1.5px solid var(--border-color,#dee2e6);text-decoration:none;color:inherit;font-size:13px;">‹</a>
    <span style="font-weight:600;font-size:14px;min-width:130px;text-align:center;">
      <%= MONTH_NAMES[month-1] %> / <%= year %>
    </span>
    <a href="/admin/overtime/user/<%= targetUser.id %>?year=<%= nextYear %>&month=<%= nextMonth %>"
       style="padding:6px 14px;border-radius:8px;border:1.5px solid var(--border-color,#dee2e6);text-decoration:none;color:inherit;font-size:13px;">›</a>
  </div>
</div>

<!-- Banner total + botão novo registro -->
<div style="display:flex;align-items:center;justify-content:space-between;background:linear-gradient(135deg,#1187BD,#0c5e84);border-radius:16px;padding:20px 28px;color:#fff;margin-bottom:24px;">
  <div>
    <div style="font-size:11px;opacity:.8;text-transform:uppercase;letter-spacing:.1em;font-weight:600;">Total do mês</div>
    <div style="font-size:38px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:-1px;line-height:1.1;"><%= total_formatted %></div>
    <div style="font-size:13px;opacity:.75;margin-top:2px;"><%= records.length %> registro(s)</div>
  </div>
  <button onclick="document.getElementById('modal-new').style.display='flex'"
    style="padding:12px 22px;background:#fff;color:#1187BD;border:none;border-radius:50px;font-size:14px;font-weight:700;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.15);">
    + Novo Registro
  </button>
</div>

<!-- Tabela -->
<div style="background:var(--bg-card,#fff);border-radius:12px;border:1px solid var(--border-color,#e9ecef);overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05);">
  <% if (records.length === 0) { %>
    <div style="padding:48px;text-align:center;color:var(--text-muted,#6c757d);">
      <div style="font-size:40px;margin-bottom:12px;">📋</div>
      <p>Nenhum registro em <%= MONTH_NAMES[month-1] %> de <%= year %>.</p>
    </div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:13.5px;">
      <thead>
        <tr style="background:#1187BD;color:#fff;">
          <th style="padding:12px 14px;text-align:left;font-weight:600;white-space:nowrap;">Data</th>
          <th style="padding:12px 14px;text-align:left;font-weight:600;">Dia</th>
          <th style="padding:12px 14px;text-align:left;font-weight:600;">Projeto</th>
          <th style="padding:12px 14px;text-align:center;font-weight:600;white-space:nowrap;">Início</th>
          <th style="padding:12px 14px;text-align:center;font-weight:600;white-space:nowrap;">Término</th>
          <th style="padding:12px 14px;text-align:center;font-weight:600;white-space:nowrap;">Hrs Extras</th>
          <th style="padding:12px 14px;text-align:left;font-weight:600;">Descrição</th>
          <th style="padding:12px 14px;text-align:center;font-weight:600;">Origem</th>
          <th style="padding:12px 14px;"></th>
        </tr>
      </thead>
      <tbody>
        <% records.forEach(function(r, idx) { %>
        <tr style="border-top:1px solid var(--border-color,#e9ecef);<%= idx % 2 === 1 ? 'background:var(--bg-alt,rgba(0,0,0,.02));' : '' %>">
          <td style="padding:11px 14px;font-weight:500;white-space:nowrap;"><%= fmtDate(r.started_at) %></td>
          <td style="padding:11px 14px;color:var(--text-muted,#6c757d);"><%= weekDay(r.started_at) %></td>
          <td style="padding:11px 14px;"><%= r.Project ? r.Project.name : (r.Ticket ? r.Ticket.title : '—') %></td>
          <td style="padding:11px 14px;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap;"><%= fmtTime(r.started_at) %></td>
          <td style="padding:11px 14px;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap;"><%= fmtTime(r.ended_at) %></td>
          <td style="padding:11px 14px;text-align:center;font-weight:700;color:#1187BD;font-variant-numeric:tabular-nums;white-space:nowrap;"><%= r.overtime_formatted %></td>
          <td style="padding:11px 14px;color:var(--text-secondary,#495057);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
              title="<%= r.description || '' %>">
            <%= r.description || '—' %>
          </td>
          <td style="padding:11px 14px;text-align:center;">
            <% if (r.source === 'ticket') { %>
              <span style="font-size:11px;padding:3px 9px;border-radius:100px;background:rgba(17,135,189,.15);color:#1187BD;font-weight:600;white-space:nowrap;">Chamado</span>
            <% } else { %>
              <span style="font-size:11px;padding:3px 9px;border-radius:100px;background:rgba(22,101,52,.15);color:#166534;font-weight:600;">Manual</span>
            <% } %>
          </td>
          <td style="padding:11px 14px;text-align:center;">
            <button onclick="deleteRecord(<%= r.id %>)"
              style="background:none;border:none;cursor:pointer;color:#dc3545;font-size:16px;padding:0 4px;"
              title="Remover">🗑</button>
          </td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr style="border-top:2px solid #1187BD;background:rgba(17,135,189,.08);">
          <td colspan="5" style="padding:12px 14px;font-weight:700;text-align:right;color:var(--text-primary,#1a1f2e);">TOTAL MÊS</td>
          <td style="padding:12px 14px;text-align:center;font-weight:800;font-size:15px;color:#1187BD;font-variant-numeric:tabular-nums;"><%= total_formatted %></td>
          <td colspan="3"></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <% } %>
</div>

<!-- Botão exportar -->
<div style="margin-top:16px;text-align:right;">
  <button onclick="exportExcel()"
    style="padding:10px 20px;border-radius:50px;background:#166534;color:#fff;border:none;font-size:13px;font-weight:600;cursor:pointer;">
    📥 Exportar Excel
  </button>
</div>

<!-- MODAL: Novo registro -->
<div id="modal-new" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:var(--bg-card);border-radius:16px;padding:32px;width:100%;max-width:480px;box-shadow:0 24px 60px rgba(0,0,0,.4);position:relative;margin:16px;border:1px solid var(--border-color);">
    <button onclick="document.getElementById('modal-new').style.display='none'"
      style="position:absolute;top:16px;right:16px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-muted);">✕</button>

    <h2 style="font-size:18px;font-weight:700;margin:0 0 20px;color:var(--text-main);">Novo Registro de Hora Extra</h2>

    <form id="form-overtime" onsubmit="submitOvertime(event)">
      <input type="hidden" name="userId" value="<%= targetUser.id %>">

      <div style="margin-bottom:16px;">
        <label style="display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:6px;">Projeto</label>
        <select name="projectId"
          style="width:100%;padding:10px 12px;border:1.5px solid var(--border-input);border-radius:8px;font-size:14px;font-family:inherit;background:var(--bg-input);color:var(--text-main);">
          <option value="">— Nenhum —</option>
          <% projects.forEach(function(p) { %>
          <option value="<%= p.id %>"><%= p.name %></option>
          <% }); %>
        </select>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
        <div>
          <label style="display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:6px;">Início *</label>
          <input type="datetime-local" name="started_at" required
            style="width:100%;padding:10px 12px;border:1.5px solid var(--border-input);border-radius:8px;font-size:14px;font-family:inherit;background:var(--bg-input);color:var(--text-main);color-scheme:dark light;">
        </div>
        <div>
          <label style="display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:6px;">Término *</label>
          <input type="datetime-local" name="ended_at" required
            style="width:100%;padding:10px 12px;border:1.5px solid var(--border-input);border-radius:8px;font-size:14px;font-family:inherit;background:var(--bg-input);color:var(--text-main);color-scheme:dark light;">
        </div>
      </div>

      <div style="margin-bottom:20px;">
        <label style="display:block;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);margin-bottom:6px;">Descrição da atividade</label>
        <textarea name="description" rows="3" placeholder="Descreva a atividade realizada..."
          style="width:100%;padding:10px 12px;border:1.5px solid var(--border-input);border-radius:8px;font-size:14px;font-family:inherit;resize:vertical;background:var(--bg-input);color:var(--text-main);"></textarea>
      </div>

      <div id="form-error"
        style="display:none;background:rgba(220,53,69,.12);color:#f87171;border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:16px;border:1px solid rgba(220,53,69,.25);"></div>

      <button type="submit"
        style="width:100%;padding:13px;background:#1187BD;color:#fff;border:none;border-radius:50px;font-size:15px;font-weight:600;font-family:inherit;cursor:pointer;">
        Salvar Hora Extra
      </button>
    </form>
  </div>
</div>

<script>
async function submitOvertime(e) {
  e.preventDefault();
  const form   = e.target;
  const errDiv = document.getElementById('form-error');
  errDiv.style.display = 'none';

  const body = {
    userId:      form.userId.value,
    projectId:   form.projectId.value || null,
    started_at:  form.started_at.value,
    ended_at:    form.ended_at.value,
    description: form.description.value,
  };

  const res  = await fetch('/api/admin/overtime', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await res.json();

  if (!res.ok) {
    errDiv.style.display = 'block';
    errDiv.textContent   = data.message || 'Erro ao salvar.';
    return;
  }

  window.location.reload();
}

async function deleteRecord(id) {
  if (!confirm('Remover este registro de hora extra?')) return;
  const res = await fetch(`/api/admin/overtime/${id}`, { method: 'DELETE' });
  if (res.ok) window.location.reload();
  else alert('Erro ao remover registro.');
}

function exportExcel() {
  const headers = ['Data','Dia','Projeto','Início','Término','Hrs Extras','Descrição','Origem'];
  const rows = [
    <% records.forEach(function(r) { %>
    [
      '<%= fmtDate(r.started_at) %>',
      '<%= weekDay(r.started_at) %>',
      '<%= (r.Project ? r.Project.name : (r.Ticket ? r.Ticket.title : '')).replace(/\'/g, "\\'") %>',
      '<%= fmtTime(r.started_at) %>',
      '<%= fmtTime(r.ended_at) %>',
      '<%= r.overtime_formatted %>',
      '<%= (r.description || '').replace(/\'/g, "\\'").replace(/\n/g,' ') %>',
      '<%= r.source === "ticket" ? "Chamado" : "Manual" %>',
    ],
    <% }); %>
  ];

  const totalRow = ['TOTAL MÊS','','','','','<%= total_formatted %>','',''];
  const csvContent = [headers, ...rows, totalRow]
    .map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(','))
    .join('\r\n');

  const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = `HE_<%= targetUser.name.replace(/ /g,'_') %>_<%= MONTH_NAMES[month-1] %>_<%= year %>.csv`;
  a.click();
  URL.revokeObjectURL(url);
}
</script>
