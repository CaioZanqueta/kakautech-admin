<%
  var pageTitle = resourceLabel
  var activeMenu = resourceId
  var statusLabels = (fieldOptions && fieldOptions.status) || []
  var priorityLabels = (fieldOptions && fieldOptions.priority) || []
  var allLabels = {}
  statusLabels.forEach(function(s) { allLabels[s.value] = s.label; })
  priorityLabels.forEach(function(s) { allLabels[s.value] = s.label; })
  var orderLabels = (fieldOptions && fieldOptions.order) || []
  orderLabels.forEach(function(s) { allLabels[s.value] = s.label; })

  // Group records by status
  var recordsByStatus = {}
  statusLabels.forEach(function(s) { recordsByStatus[s.value] = []; })
  records.forEach(function(record) {
    var st = record.status || 'unknown';
    if (!recordsByStatus[st]) recordsByStatus[st] = [];
    recordsByStatus[st].push(record);
  })

  // Badge class helper
  function getBadgeClass(field, val) {
    if (['active','done','approved','closed'].includes(val)) return 'badge-success';
    if (['pending','in_progress','doing','medium'].includes(val)) return 'badge-warning';
    if (['open','low','backlog'].includes(val)) return 'badge-info';
    if (['archived','rejected','inactive','high'].includes(val)) return 'badge-danger';
    return 'badge-secondary';
  }

  // Column color accents
  var columnColors = {}
  statusLabels.forEach(function(s) {
    if (['open','backlog'].includes(s.value)) columnColors[s.value] = 'var(--info)';
    else if (['pending','doing','in_progress','medium'].includes(s.value)) columnColors[s.value] = 'var(--warning)';
    else if (['done','approved','closed','active'].includes(s.value)) columnColors[s.value] = 'var(--success)';
    else if (['rejected','archived'].includes(s.value)) columnColors[s.value] = 'var(--danger)';
    else columnColors[s.value] = 'var(--gray-500)';
  })

  // Card URL helper
  function getCardUrl(record) {
    if (resourceId === 'tickets') return '/admin/resources/tickets/' + record.id + '/show';
    return '/admin/resources/' + resourceId + '/' + record.id;
  }
%>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <div>
    <h1 class="page-title"><%= resourceLabel %></h1>
    <p class="page-subtitle"><%= total %> registro<%= total !== 1 ? 's' : '' %> encontrado<%= total !== 1 ? 's' : '' %></p>
  </div>
  <div class="btn-group">
    <% if (statusLabels.length > 0) { %>
      <div class="view-toggle">
        <a href="/admin/resources/<%= resourceId %>?view=list" class="view-toggle-btn" title="Lista">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </a>
        <a href="/admin/resources/<%= resourceId %>" class="view-toggle-btn active" title="Kanban">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="18" rx="1"/><rect x="10" y="3" width="5" height="12" rx="1"/><rect x="17" y="3" width="5" height="15" rx="1"/></svg>
        </a>
      </div>
    <% } %>
    <% if (editFields && editFields.length > 0) { %>
      <a href="/admin/resources/<%= resourceId %>/new" class="btn btn-primary">+ Criar novo</a>
    <% } %>
  </div>
</div>

<!-- KANBAN BOARD -->
<div class="kanban-board" id="kanban-board">
  <% statusLabels.forEach(function(statusObj) { %>
    <div class="kanban-column"
         data-status="<%= statusObj.value %>"
         id="col-<%= statusObj.value %>">
      <div class="kanban-column-header">
        <span class="kanban-column-indicator" style="background: <%= columnColors[statusObj.value] %>"></span>
        <span class="kanban-column-title"><%= statusObj.label %></span>
        <span class="kanban-column-count"><%= (recordsByStatus[statusObj.value] || []).length %></span>
      </div>
      <div class="kanban-column-body"
           data-status="<%= statusObj.value %>"
           ondragover="handleDragOver(event)"
           ondragleave="handleDragLeave(event)"
           ondrop="handleDrop(event)">
        <% (recordsByStatus[statusObj.value] || []).forEach(function(record) { %>
          <div class="kanban-card"
               draggable="true"
               data-id="<%= record.id %>"
               data-status="<%= record.status %>"
               data-url="<%= getCardUrl(record) %>"
               id="card-<%= record.id %>"
               ondragstart="handleDragStart(event)"
               ondragend="handleDragEnd(event)"
               onclick="handleCardClick(event)">
            <div class="kanban-card-title">
              <%= record.title || record.name || '#' + record.id %>
            </div>
            <div class="kanban-card-meta">
              <% if (record.priority) { %>
                <span class="badge <%= getBadgeClass('priority', record.priority) %>" style="font-size:10px; padding: 2px 8px;"><%= allLabels[record.priority] || record.priority %></span>
              <% } %>
              <% if (record.order) { %>
                <span class="badge <%= getBadgeClass('order', record.order) %>" style="font-size:10px; padding: 2px 8px;"><%= allLabels[record.order] || record.order %></span>
              <% } %>
            </div>
            <div class="kanban-card-footer">
              <%
                var assignee = '';
                if (record.User && record.User.name) assignee = record.User.name;
                var projectName = '';
                if (record.Project && record.Project.name) projectName = record.Project.name;
              %>
              <% if (assignee) { %>
                <span class="kanban-card-assignee" title="<%= assignee %>">
                  <span class="kanban-card-avatar"><%= assignee.charAt(0).toUpperCase() %></span>
                  <%= assignee %>
                </span>
              <% } %>
              <% if (projectName) { %>
                <span class="kanban-card-project" title="<%= projectName %>">📁 <%= projectName %></span>
              <% } %>
            </div>
            <% if (record.due_date) { %>
              <div class="kanban-card-due">
                📅 <%= new Date(record.due_date).toLocaleDateString('pt-BR') %>
              </div>
            <% } %>
            <% if (record.createdAt) { %>
              <div class="kanban-card-date">
                <%= new Date(record.createdAt).toLocaleDateString('pt-BR') %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>
</div>

<!-- TOAST -->
<div class="kanban-toast" id="kanban-toast"></div>

<script>
var draggedCard = null;
var sourceColumn = null;
var isDragging = false;

function handleDragStart(e) {
  isDragging = true;
  draggedCard = e.target.closest('.kanban-card');
  sourceColumn = draggedCard.closest('.kanban-column-body');
  draggedCard.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
  e.dataTransfer.setData('text/plain', draggedCard.dataset.id);
}

function handleDragEnd(e) {
  if (draggedCard) draggedCard.classList.remove('dragging');
  document.querySelectorAll('.kanban-column-body').forEach(function(col) {
    col.classList.remove('drag-over');
  });
  draggedCard = null;
  sourceColumn = null;
  setTimeout(function() { isDragging = false; }, 100);
}

function handleCardClick(e) {
  if (isDragging) return;
  var card = e.target.closest('.kanban-card');
  if (card && card.dataset.url) {
    window.location.href = card.dataset.url;
  }
}

function handleDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  var colBody = e.target.closest('.kanban-column-body');
  if (colBody) colBody.classList.add('drag-over');
}

function handleDragLeave(e) {
  var colBody = e.target.closest('.kanban-column-body');
  if (colBody && !colBody.contains(e.relatedTarget)) {
    colBody.classList.remove('drag-over');
  }
}

async function handleDrop(e) {
  e.preventDefault();
  var colBody = e.target.closest('.kanban-column-body');
  if (!colBody || !draggedCard) return;
  colBody.classList.remove('drag-over');

  var newStatus = colBody.dataset.status;
  var cardId = draggedCard.dataset.id;
  var oldStatus = draggedCard.dataset.status;

  if (newStatus === oldStatus) return;

  // Optimistic UI update
  colBody.appendChild(draggedCard);
  draggedCard.dataset.status = newStatus;
  draggedCard.classList.remove('dragging');
  updateColumnCounts();

  try {
    var resp = await fetch('/admin/api/<%= resourceId %>/' + cardId, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    });

    if (!resp.ok) {
      throw new Error('Erro ao atualizar status');
    }

    showToast('Status atualizado com sucesso!', 'success');
  } catch (err) {
    // Revert on error
    sourceColumn.appendChild(draggedCard);
    draggedCard.dataset.status = oldStatus;
    updateColumnCounts();
    showToast('Erro ao atualizar o status. Tente novamente.', 'error');
  }
}

function updateColumnCounts() {
  document.querySelectorAll('.kanban-column').forEach(function(col) {
    var body = col.querySelector('.kanban-column-body');
    var count = col.querySelector('.kanban-column-count');
    if (body && count) {
      count.textContent = body.querySelectorAll('.kanban-card').length;
    }
  });
}

function showToast(message, type) {
  var toast = document.getElementById('kanban-toast');
  toast.textContent = message;
  toast.className = 'kanban-toast show ' + (type === 'error' ? 'toast-error' : 'toast-success');
  setTimeout(function() {
    toast.classList.remove('show');
  }, 3000);
}
</script>
