<% var pageTitle=resourceLabel,activeMenu=resourceId,statusLabels=(fieldOptions&&fieldOptions.status)||[],byStatus={};statusLabels.forEach(s=>byStatus[s.value]=[]);records.forEach(r=>(byStatus[r.status]||(byStatus[r.status]=[])).push(r));function url(r){return resourceId==='tickets'?'/admin/resources/tickets/'+r.id+'/show':'/admin/resources/'+resourceId+'/'+r.id} %><div style="display:flex;justify-content:space-between"><div><h1 class="page-title"><%=resourceLabel%></h1><p><%=total%> registros</p></div><a class="btn btn-primary" href="/admin/resources/<%=resourceId%>/new">+ Criar novo</a></div><div class="kanban-board"><%statusLabels.forEach(function(st){%><div class="kanban-column" data-status="<%=st.value%>"><div class="kanban-column-header"><b><%=st.label%></b><span class="kanban-column-count"><%=(byStatus[st.value]||[]).length%></span></div><div class="kanban-column-body" data-status="<%=st.value%>" ondragover="event.preventDefault()" ondrop="dropCard(event)"><%(byStatus[st.value]||[]).forEach(function(r){%><article class="kanban-card" tabindex="0" draggable="true" data-id="<%=r.id%>" data-status="<%=r.status%>" data-url="<%=url(r)%>" ondragstart="dragCard(event)" onclick="if(!dragging)location.href=this.dataset.url" onkeydown="if(event.key==='Enter')location.href=this.dataset.url"><b><%=r.title||r.name%></b><div><%if(r.priority){%><span class="badge"><%=r.priority%></span><%}%><%if(r.Project){%> 📁 <%=r.Project.name%><%}%></div><small><%if(r.User){%><%=r.User.name%><%}%><%if(r.due_date){%> · 📅 <%=new Date(r.due_date).toLocaleDateString('pt-BR')%><%}%></small></article><%})%></div></div><%})%></div><div id="kanban-toast" class="kanban-toast"></div><script>var dragged=null,origin=null,next=null,dragging=false,resource='<%=resourceId%>';function dragCard(e){dragging=true;dragged=e.currentTarget;origin=dragged.parentNode;next=dragged.nextSibling;e.dataTransfer.setData('text/plain',dragged.dataset.id)}async function dropCard(e){e.preventDefault();if(!dragged)return;var col=e.currentTarget,status=col.dataset.status,old=dragged.dataset.status,target=e.target.closest('.kanban-card');if(target&&target!==dragged)col.insertBefore(dragged,target);else col.appendChild(dragged);dragged.dataset.status=status;counts();try{var position=Array.prototype.indexOf.call(col.querySelectorAll('.kanban-card'),dragged),endpoint=resource==='tasks'?'/admin/api/tasks-management/'+dragged.dataset.id+'/move':'/admin/api/'+resource+'/'+dragged.dataset.id,res=await fetch(endpoint,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:status,position:position})});if(!res.ok)throw Error();toast('Atualizado','success')}catch(x){if(next&&next.parentNode===origin)origin.insertBefore(dragged,next);else origin.appendChild(dragged);dragged.dataset.status=old;counts();toast('Falha ao mover; alteração revertida','error')}finally{setTimeout(()=>dragging=false,100)}}function counts(){document.querySelectorAll('.kanban-column').forEach(c=>c.querySelector('.kanban-column-count').textContent=c.querySelectorAll('.kanban-card').length)}function toast(m,t){var x=document.getElementById('kanban-toast');x.textContent=m;x.className='kanban-toast show toast-'+t;setTimeout(()=>x.className='kanban-toast',2500)}</script>
