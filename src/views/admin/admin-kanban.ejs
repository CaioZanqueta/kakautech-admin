<% var pageTitle=resourceLabel,activeMenu=resourceId,statusLabels=(fieldOptions&&fieldOptions.status)||[],byStatus={};statusLabels.forEach(s=>byStatus[s.value]=[]);records.forEach(r=>(byStatus[r.status]||(byStatus[r.status]=[])).push(r));function url(r){return resourceId==='tickets'?'/admin/resources/tickets/'+r.id+'/show':'/admin/resources/'+resourceId+'/'+r.id} %><div style="display:flex;justify-content:space-between"><div><h1 class="page-title"><%=resourceLabel%></h1><p><%=total%> registros</p></div><a class="btn btn-primary" href="/admin/resources/<%=resourceId%>/new">+ Criar novo</a></div><div class="kanban-board" data-resource="<%=resourceId%>"><%statusLabels.forEach(function(st){%><div class="kanban-column" data-status="<%=st.value%>"><div class="kanban-column-header"><b><%=st.label%></b><span class="kanban-column-count"><%=(byStatus[st.value]||[]).length%></span></div><div class="kanban-column-body" data-status="<%=st.value%>"><%(byStatus[st.value]||[]).forEach(function(r){%><article class="kanban-card" tabindex="0" draggable="true" data-id="<%=r.id%>" data-status="<%=r.status%>" data-url="<%=url(r)%>"><b><%=r.title||r.name%></b><div><%if(r.priority){%><span class="badge"><%=r.priority%></span><%}%><%if(r.Project){%> 📁 <%=r.Project.name%><%}%></div><small><%if(r.User){%><%=r.User.name%><%}%><%if(r.due_date){%> · 📅 <%=new Date(r.due_date).toLocaleDateString('pt-BR')%><%}%></small></article><%})%></div></div><%})%></div><div id="kanban-toast" class="kanban-toast"></div><script>var board=document.querySelector('.kanban-board'),resource=board.dataset.resource,dragged=null,origin=null,next=null,dragging=false;board.addEventListener('dragstart',function(e){var card=e.target.closest('.kanban-card');if(!card)return;dragging=true;dragged=card;origin=card.parentNode;next=card.nextSibling;e.dataTransfer.setData('text/plain',card.dataset.id)});board.addEventListener('dragover',function(e){if(e.target.closest('.kanban-column-body'))e.preventDefault()});board.addEventListener('click',function(e){var card=e.target.closest('.kanban-card');if(card&&!dragging)location.href=card.dataset.url});board.addEventListener('keydown',function(e){var card=e.target.closest('.kanban-card');if(card&&e.key==='Enter')location.href=card.dataset.url});board.addEventListener('dragend',function(){setTimeout(function(){dragging=false},100)});board.addEventListener('drop',async function(e){var col=e.target.closest('.kanban-column-body');if(!col||!dragged)return;e.preventDefault();var status=col.dataset.status,old=dragged.dataset.status,target=e.target.closest('.kanban-card');if(target&&target!==dragged)col.insertBefore(dragged,target);else col.appendChild(dragged);dragged.dataset.status=status;counts();try{var position=Array.prototype.indexOf.call(col.querySelectorAll('.kanban-card'),dragged),endpoint=resource==='tasks'?'/admin/api/tasks-management/'+dragged.dataset.id+'/move':'/admin/api/'+resource+'/'+dragged.dataset.id,response=await fetch(endpoint,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:status,position:position})});if(!response.ok)throw Error();toast('Atualizado','success')}catch(error){if(next&&next.parentNode===origin)origin.insertBefore(dragged,next);else origin.appendChild(dragged);dragged.dataset.status=old;counts();toast('Falha ao mover; alteração revertida','error')}});function counts(){document.querySelectorAll('.kanban-column').forEach(function(c){c.querySelector('.kanban-column-count').textContent=c.querySelectorAll('.kanban-card').length})}function toast(message,type){var element=document.getElementById('kanban-toast');element.textContent=message;element.className='kanban-toast show toast-'+type;setTimeout(function(){element.className='kanban-toast'},2500)}</script>
