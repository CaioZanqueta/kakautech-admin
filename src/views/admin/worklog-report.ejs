<h1 class="page-title">Relatório consolidado de horas</h1><form class="card" method="GET" style="display:flex;gap:10px;flex-wrap:wrap"><select name="client_id"><option value="">Cliente</option><% clients.forEach(function(x){%><option value="<%=x.id%>" <%=filters.client_id==x.id?'selected':''%>><%=x.name%></option><%})%></select><select name="project_id"><option value="">Projeto</option><% projects.forEach(function(x){%><option value="<%=x.id%>" <%=filters.project_id==x.id?'selected':''%>><%=x.name%></option><%})%></select><select name="user_id"><option value="">Profissional</option><% users.forEach(function(x){%><option value="<%=x.id%>" <%=filters.user_id==x.id?'selected':''%>><%=x.name%></option><%})%></select><input type="date" name="start_date" value="<%=filters.start_date||''%>"><input type="date" name="end_date" value="<%=filters.end_date||''%>"><select name="source"><option value="">Todas origens</option><option value="task">Tarefa</option><option value="ticket">Chamado</option></select><button class="btn btn-primary">Filtrar</button></form><div class="card" style="margin-top:16px"><h2>Total: <%= (result.total/60).toFixed(2)%>h</h2><p>Faturável: <%= (result.billable/60).toFixed(2)%>h</p><a class="btn" href="/admin/reports/worklogs/export/csv?<%=new URLSearchParams(filters).toString()%>">CSV</a> <a class="btn" href="/admin/reports/worklogs/export/xlsx?<%=new URLSearchParams(filters).toString()%>">Excel</a><div style="overflow:auto"><table style="width:100%"><thead><tr><th>Cliente</th><th>Projeto</th><th>Data</th><th>Profissional</th><th>Tipo</th><th>Referência</th><th>Descrição</th><th>Minutos</th></tr></thead><tbody><%result.rows.forEach(function(x){%><tr><td><%=x.client%></td><td><%=x.project%></td><td><%=x.date%></td><td><%=x.user%></td><td><%=x.type%></td><td><%=x.reference%></td><td><%=x.description%></td><td><%=x.minutes%></td></tr><%})%></tbody></table></div></div>
