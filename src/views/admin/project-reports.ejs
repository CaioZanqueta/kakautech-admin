<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Relatórios — <%= project.name %> — Kakau Tech Admin</title>
  <link rel="icon" type="image/webp" href="/public/favicon.webp" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Kakau core brand */
      --primary: #1187BD;
      --primary-hover: #0e6a94;
      --primary-dark: #0c5e84;

      /* Theme Variables — Light (Default) */
      --bg-body: #f4f5f7;
      --bg-card: #ffffff;
      --bg-header: #ffffff;
      --bg-input: #ffffff;
      --text-main: #212529;
      --text-dim: #495057;
      --text-muted: #6c757d;
      --border-color: #e9ecef;
      --border-input: #ced4da;
      --table-hover: #f8f9fa;
      --shadow-color: rgba(0,0,0,0.06);
    }

    body.dark-mode {
      --bg-body: #0b0e14;
      --bg-card: #151921;
      --bg-header: #151921;
      --bg-input: #1b212c;
      --text-main: #e9ecef;
      --text-dim: #adb5bd;
      --text-muted: #959fad;
      --border-color: rgba(255,255,255,0.08);
      --border-input: rgba(255,255,255,0.12);
      --table-hover: rgba(255,255,255,0.02);
      --shadow-color: rgba(0,0,0,0.2);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-body); color: var(--text-main);
      -webkit-font-smoothing: antialiased; min-height: 100vh;
      transition: background 0.3s ease, color 0.3s ease;
    }

    .container { padding: 28px 40px; max-width: 1200px; margin: auto; }

    /* HERO */
    .report-hero {
      background: linear-gradient(135deg, #0d1b2a 0%, #152238 60%, #0c5e84 100%);
      border-radius: 14px; padding: 32px 36px; color: #fff; margin-bottom: 24px;
      position: relative; overflow: hidden;
    }
    .report-hero::before { content: ''; position: absolute; top: -40%; right: -15%; width: 300px; height: 300px; border-radius: 50%; background: rgba(17,135,189,0.12); }
    .report-hero::after { content: ''; position: absolute; bottom: -30%; left: -10%; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,0.04); }
    .report-hero h1 { font-size: 26px; font-weight: 700; margin: 0 0 6px; letter-spacing: -0.3px; position: relative; z-index: 1; }
    .report-hero p { font-size: 14px; opacity: 0.7; margin: 0; position: relative; z-index: 1; }
    .back-link { color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 12px; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: all 0.2s; position: relative; z-index: 1; }
    .back-link:hover { color: #fff; }

    /* CARDS */
    .card {
      background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px;
      padding: 24px; box-shadow: 0 1px 3px var(--shadow-color);
      transition: all 0.2s; margin-bottom: 20px;
    }
    .card:hover { box-shadow: 0 4px 12px var(--shadow-color); }

    /* FILTERS */
    .filters-row { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; }
    .form-group { display: flex; flex-direction: column; flex: 1; min-width: 180px; }
    .form-group label {
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;
      color: var(--text-muted); margin-bottom: 8px;
    }
    .form-group select {
      padding: 10px 14px; border: 1.5px solid var(--border-input); border-radius: 10px;
      font-size: 14px; font-family: 'Inter', sans-serif; color: var(--text-main);
      background: var(--bg-input); transition: all 0.2s; height: 42px;
    }
    .form-group select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(17,135,189,0.12); }

    /* BUTTONS */
    .btn-group { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; }
    .btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 10px 22px; border-radius: 50px; font-size: 13px; font-weight: 600;
      border: 1.5px solid var(--border-input); background: var(--bg-card); color: var(--text-dim);
      cursor: pointer; transition: all 0.2s; font-family: 'Inter', sans-serif;
      text-decoration: none;
    }
    .btn:hover { border-color: var(--primary); color: var(--primary); transform: translateY(-1px); box-shadow: 0 2px 8px var(--shadow-color); }
    .btn-primary { background: var(--primary); color: #fff; border-color: var(--primary); }
    .btn-primary:hover { background: var(--primary-hover); color: #fff; box-shadow: 0 4px 12px rgba(17,135,189,0.3); }

    /* RESULTS */
    #results h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: var(--text-main); }
    .period-info { font-size: 13px; color: var(--text-muted); margin-bottom: 16px; display: flex; align-items: center; gap: 6px; }
    #results table { width: 100%; border-collapse: collapse; }
    #results th {
      padding: 12px 16px; text-align: left; font-size: 11px; text-transform: uppercase;
      letter-spacing: 0.8px; font-weight: 700; color: var(--text-muted); background: var(--table-hover);
      border-bottom: 2px solid var(--border-color);
    }
    #results td { padding: 12px 16px; border-bottom: 1px solid var(--border-color); font-size: 14px; color: var(--text-dim); }
    #results tr:hover td { background: var(--table-hover); opacity: 0.8; }

    /* STATUS/PRIORITY BADGES */
    .status-badge {
      display: inline-flex; align-items: center; gap: 4px; padding: 3px 12px;
      border-radius: 50px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .status-open { background: rgba(17,135,189,0.15); color: var(--primary); }
    .status-pending { background: rgba(255,193,7,0.15); color: #ffc107; }
    .status-in_progress { background: rgba(102,16,242,0.15); color: #6610f2; }
    .status-closed { background: rgba(40,167,69,0.15); color: #28a745; }
    .priority-low { background: rgba(40,167,69,0.15); color: #28a745; }
    .priority-medium { background: rgba(17,135,189,0.15); color: var(--primary); }
    .priority-high { background: rgba(220,53,69,0.15); color: #dc3545; }

    /* METRIC CARD */
    .metric-card {
      display: inline-flex; flex-direction: column; padding: 24px 32px;
      background: var(--table-hover); border-radius: 14px; border: 1px solid var(--border-color);
    }
    .metric-value { font-size: 42px; font-weight: 800; color: var(--text-main); letter-spacing: -1px; }
    .metric-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-top: 4px; }

    /* LOADING */
    .loading-text { color: var(--text-muted); font-size: 14px; display: flex; align-items: center; gap: 8px; }
    .loading-text::before { content: ""; width: 16px; height: 16px; border: 2px solid var(--primary); border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .success-text { color: #28a745; font-weight: 600; font-size: 14px; }
    .error-text { color: #dc3545; font-weight: 600; font-size: 14px; }
    .empty-text { color: var(--text-muted); font-size: 14px; padding: 20px 0; text-align: center; }

    /* NAV BAR */
    .topbar {
      background: var(--bg-header); border-bottom: 1px solid var(--border-color);
      padding: 14px 40px; display: flex; align-items: center; justify-content: space-between;
      box-shadow: 0 1px 3px var(--shadow-color);
    }
    .topbar-left { display: flex; align-items: center; gap: 16px; }
    .topbar-logo { height: 24px; filter: var(--logo-filter, none); }
    .topbar-sep { width: 1px; height: 24px; background: var(--border-color); }
    .topbar-title { font-size: 14px; font-weight: 600; color: var(--text-main); }
    .topbar-right { display: flex; align-items: center; gap: 16px; }
    .topbar-user { font-size: 13px; color: var(--text-muted); }
    .btn-back-admin {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 18px;
      border-radius: 50px; font-size: 13px; font-weight: 600; background: var(--primary);
      color: #fff; text-decoration: none; border: none; transition: all 0.2s;
    }
    .btn-back-admin:hover { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(17,135,189,0.3); }

    /* Theme Toggle Button */
    .theme-toggle-btn {
      background: none; border: none; cursor: pointer; color: var(--text-muted);
      width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center;
      justify-content: center; transition: all 0.2s; border: 1px solid var(--border-color);
    }
    .theme-toggle-btn:hover { background: var(--table-hover); color: var(--primary); }

    body.dark-mode .topbar-logo { filter: brightness(0) invert(1); }

    @media (max-width: 768px) {
      .container { padding: 16px; }
      .filters-row { flex-direction: column; }
      .form-group { min-width: auto; }
      .topbar { padding: 12px 16px; }
    }
  </style>
</head>
<body>
  <!-- THEME SCRIPT (Critical) -->
  <script>
    (function() {
      const theme = localStorage.getItem('admin-theme') || 'light';
      if (theme === 'dark') document.documentElement.classList.add('dark-mode');
    })();
  </script>

  <!-- TOP NAV -->
  <div class="topbar">
    <div class="topbar-left">
      <img src="/public/kakau.webp" alt="Kakau Tech" class="topbar-logo">
      <div class="topbar-sep"></div>
      <span class="topbar-title">Relatórios</span>
    </div>
    <div class="topbar-right">
      <button id="themeToggle" class="theme-toggle-btn" title="Alternar Tema">
        <svg id="themeToggleIcon" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"/>
        </svg>
      </button>

      <% if (typeof adminUser !== 'undefined' && adminUser) { %>
        <span class="topbar-user"><%= adminUser.name || adminUser.email %></span>
      <% } %>
      <a href="/admin" class="btn-back-admin">← Painel Admin</a>
    </div>
  </div>

  <div class="container">
    <!-- HERO -->
    <div class="report-hero">
      <a href="/admin/resources/projects" class="back-link">← Voltar para Projetos</a>
      <h1>📈 Relatórios: <%= project.name %></h1>
      <p>Selecione os filtros abaixo para gerar o seu relatório.</p>
    </div>

    <!-- FILTERS -->
    <div class="card">
      <div class="filters-row">
        <div class="form-group">
          <label for="reportType">Tipo de Relatório</label>
          <select id="reportType">
            <option value="hours">Horas Gastas</option>
            <option value="tickets">Chamados</option>
          </select>
        </div>
        <div class="form-group">
          <label for="period">Período</label>
          <select id="period">
            <option value="current_month">Este Mês</option>
            <option value="last_month">Mês Passado</option>
            <option value="current_quarter">Este Trimestre</option>
            <option value="current_year">Este Ano</option>
          </select>
        </div>
        <div class="btn-group">
          <button id="generateReport" class="btn btn-primary">📊 Visualizar</button>
          <button id="exportPdf" class="btn">📄 PDF</button>
          <button id="exportExcel" class="btn">📗 Excel</button>
          <button id="exportCsv" class="btn">📋 CSV</button>
        </div>
      </div>
    </div>

    <!-- RESULTS -->
    <div class="card">
      <div id="results">
        <p class="empty-text">Selecione os filtros e clique em "Visualizar" para gerar um relatório.</p>
      </div>
    </div>
  </div>

  <!-- Hidden form for native browser downloads -->
  <form id="downloadForm" method="POST" style="display:none;">
    <input type="hidden" name="data[reportType]" id="formReportType">
    <input type="hidden" name="data[period]" id="formPeriod">
    <input type="hidden" name="data[format]" id="formFormat">
  </form>

  <script>
    const projectId = "<%= project.id %>";
    const projectName = "<%= project.name.toLowerCase().replace(/\\s+/g, '_') %>";
    const reportTypeEl = document.getElementById('reportType');
    const periodEl = document.getElementById('period');
    const generateBtn = document.getElementById('generateReport');
    const exportCsvBtn = document.getElementById('exportCsv');
    const exportExcelBtn = document.getElementById('exportExcel');
    const exportPdfBtn = document.getElementById('exportPdf');
    const resultsDiv = document.getElementById('results');

    const statusLabels = { open: 'Aberto', pending: 'Pendente', in_progress: 'Em Andamento', closed: 'Fechado' };
    const priorityLabels = { low: 'Baixa', medium: 'Média', high: 'Alta' };

    // For JSON data (Visualizar button) — uses fetch
    async function fetchJsonData() {
      const payload = {
        data: { reportType: reportTypeEl.value, period: periodEl.value, format: 'json' }
      };
      const response = await fetch(`/api/projects/${projectId}/reports`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.message || 'Falha ao buscar dados.');
      }
      return response.json();
    }

    // For file downloads (PDF/Excel/CSV) — direct navigation with filename in URL
    function downloadFile(format) {
      const ext = format === 'xlsx' ? 'xlsx' : format;
      const filename = `relatorio_${reportTypeEl.value}_${projectName}.${ext}`;
      const params = new URLSearchParams({
        reportType: reportTypeEl.value,
        period: periodEl.value,
        format: format
      });
      // Filename in URL path ensures browser uses it regardless of Content-Disposition handling
      window.location.href = `/admin/projects/${projectId}/reports/download/${encodeURIComponent(filename)}?${params.toString()}`;
    }

    generateBtn.addEventListener('click', async () => {
      resultsDiv.innerHTML = '<p class="loading-text">Gerando relatório...</p>';
      try {
        const data = await fetchJsonData();
        renderResults(data);
      } catch (error) {
        resultsDiv.innerHTML = `<p class="error-text">❌ Erro: ${error.message}</p>`;
      }
    });

    exportCsvBtn.addEventListener('click', () => {
      resultsDiv.innerHTML = '<p class="success-text">✅ Download CSV iniciado!</p>';
      downloadFile('csv');
    });

    exportExcelBtn.addEventListener('click', () => {
      resultsDiv.innerHTML = '<p class="success-text">✅ Download Excel iniciado!</p>';
      downloadFile('xlsx');
    });

    exportPdfBtn.addEventListener('click', () => {
      resultsDiv.innerHTML = '<p class="success-text">✅ Download PDF iniciado (pode demorar alguns segundos)...</p>';
      downloadFile('pdf');
    });

    function renderResults(data) {
      let html = `
        <h3>Resultado do Relatório</h3>
        <p class="period-info">📅 Período de ${data.period.start} a ${data.period.end}</p>
      `;
      if (data.type === 'hours') {
        html += `<div class="metric-card"><span class="metric-value">${data.totalHours}h</span><span class="metric-label">Total de Horas Gastas</span></div>`;
      }
      if (data.type === 'tickets' && data.tickets && data.tickets.length > 0) {
        html += `<div style="overflow-x:auto;"><table><thead><tr><th>Título</th><th>Criado Por</th><th>Status</th><th>Prioridade</th><th>Data</th></tr></thead><tbody>
          ${data.tickets.map(t => {
            const sCls = 'status-' + (t.status || 'open');
            const pCls = 'priority-' + (t.priority || 'medium');
            return `<tr>
              <td style="font-weight:600;">${t.title}</td>
              <td>${t.Client?.name || 'N/D'}</td>
              <td><span class="status-badge ${sCls}">${statusLabels[t.status] || t.status}</span></td>
              <td><span class="status-badge ${pCls}">${priorityLabels[t.priority] || t.priority}</span></td>
              <td>${new Date(t.createdAt).toLocaleDateString('pt-BR')}</td>
            </tr>`;
          }).join('')}
        </tbody></table></div>`;
      } else if (data.type === 'tickets') {
        html += '<p class="empty-text">Nenhum chamado encontrado para o período selecionado.</p>';
      }
      resultsDiv.innerHTML = html;
    }

    // THEME HANDLING
    const themeBtn = document.getElementById('themeToggle');
    const htmlEl = document.documentElement;

    function applyTheme(theme) {
      if (theme === 'dark') {
        htmlEl.classList.add('dark-mode');
        document.body.classList.add('dark-mode');
      } else {
        htmlEl.classList.remove('dark-mode');
        document.body.classList.remove('dark-mode');
      }
    }

    themeBtn.addEventListener('click', () => {
      const currentTheme = htmlEl.classList.contains('dark-mode') ? 'dark' : 'light';
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      applyTheme(newTheme);
      localStorage.setItem('admin-theme', newTheme);
    });

    // Initialize on load
    applyTheme(localStorage.getItem('admin-theme') || 'light');
  </script>
</body>
</html>