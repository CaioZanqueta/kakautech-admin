<%
  var pageTitle = resourceLabel
  var activeMenu = resourceId
  var statusLabels = (fieldOptions && fieldOptions.status) || []
  var priorityLabels = (fieldOptions && fieldOptions.priority) || []
  var allLabels = {}
  statusLabels.forEach(function(s) { allLabels[s.value] = s.label; })
  priorityLabels.forEach(function(s) { allLabels[s.value] = s.label; })
  var roleLabels = (fieldOptions && fieldOptions.role) || []
  roleLabels.forEach(function(s) { allLabels[s.value] = s.label; })
  var orderLabels = (fieldOptions && fieldOptions.order) || []
  orderLabels.forEach(function(s) { allLabels[s.value] = s.label; })
%>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <div>
    <h1 class="page-title"><%= resourceLabel %></h1>
    <p class="page-subtitle"><%= total %> registro<%= total !== 1 ? 's' : '' %> encontrado<%= total !== 1 ? 's' : '' %></p>
  </div>
  <div class="btn-group">
    <% if (statusLabels.length > 0) { %>
      <div class="view-toggle">
        <a href="/admin/resources/<%= resourceId %>?view=list" class="view-toggle-btn active" title="Lista">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </a>
        <a href="/admin/resources/<%= resourceId %>" class="view-toggle-btn" title="Kanban">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="5" height="18" rx="1"/><rect x="10" y="3" width="5" height="12" rx="1"/><rect x="17" y="3" width="5" height="15" rx="1"/></svg>
        </a>
      </div>
    <% } %>
    <% if (editFields && editFields.length > 0) { %>
      <a href="/admin/resources/<%= resourceId %>/new" class="btn btn-primary">+ Criar novo</a>
    <% } %>
  </div>
</div>

<!-- FILTROS -->
<% if (statusLabels.length > 0 || priorityLabels.length > 0) { %>
<div class="card" style="padding: 16px 20px; margin-bottom: 20px;">
  <form method="GET" class="filters-row">
    <% if (statusLabels.length > 0) { %>
      <div class="form-group">
        <label for="filter-status">Status</label>
        <select name="filter.status" id="filter-status">
          <option value="">Todos</option>
          <% statusLabels.forEach(function(s) { %>
            <option value="<%= s.value %>" <%= currentFilters['filter.status'] === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <% if (priorityLabels.length > 0) { %>
      <div class="form-group">
        <label for="filter-priority">Prioridade</label>
        <select name="filter.priority" id="filter-priority">
          <option value="">Todas</option>
          <% priorityLabels.forEach(function(s) { %>
            <option value="<%= s.value %>" <%= currentFilters['filter.priority'] === s.value ? 'selected' : '' %>><%= s.label %></option>
          <% }); %>
        </select>
      </div>
    <% } %>
    <div class="form-group">
      <label>&nbsp;</label>
      <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
    </div>
    <% if (Object.keys(currentFilters).some(function(k) { return k.startsWith('filter.') && currentFilters[k]; })) { %>
      <div class="form-group">
        <label>&nbsp;</label>
        <a href="/admin/resources/<%= resourceId %>" class="btn btn-sm">Limpar</a>
      </div>
    <% } %>
  </form>
</div>
<% } %>

<!-- TABELA -->
<div class="card" style="padding: 0; overflow: hidden;">
  <div class="table-wrapper">
    <table class="admin-table">
      <thead>
        <tr>
          <% listFields.forEach(function(field) { %>
            <th><%= fieldLabels[field] || field %></th>
          <% }); %>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (records.length === 0) { %>
          <tr><td colspan="<%= listFields.length + 1 %>">
            <div class="empty-state">
              <div class="empty-icon">📭</div>
              <p>Nenhum registro encontrado</p>
            </div>
          </td></tr>
        <% } else { %>
          <% records.forEach(function(record) { %>
            <tr>
              <% listFields.forEach(function(field) { %>
                <td>
                  <%
                    var val = record[field];
                    if (field.endsWith('Id') || field === 'userId' || field === 'clientId' || field === 'projectId') {
                      var assocKey = field.replace(/Id$/, '');
                      var assocName = assocKey.charAt(0).toUpperCase() + assocKey.slice(1);
                      if (record[assocName] && record[assocName].name) val = record[assocName].name;
                      else if (record[assocKey] && record[assocKey].name) val = record[assocKey].name;
                    }
                    if (field === 'user_id' && record.User) val = record.User.name;
                    if (field === 'client_id' && record.Client) val = record.Client.name;
                    if (field === 'project_id' && record.Project) val = record.Project.name;
                    if (field === 'ticket_id' && record.Ticket) val = record.Ticket.title;
                    var displayVal = allLabels[val] || val;
                    var badgeClass = '';
                    if (field === 'status' || field === 'priority') {
                      if (['active','done','approved','closed'].includes(val)) badgeClass = 'badge-success';
                      else if (['pending','in_progress','doing','medium'].includes(val)) badgeClass = 'badge-warning';
                      else if (['open','low','backlog'].includes(val)) badgeClass = 'badge-info';
                      else if (['archived','rejected','inactive','high'].includes(val)) badgeClass = 'badge-danger';
                      else badgeClass = 'badge-secondary';
                    }
                    if (field === 'createdAt' || field === 'updatedAt' || field === 'due_date') {
                      if (val) {
                        var d = new Date(val);
                        displayVal = d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
                      } else { displayVal = '—'; }
                    }
                  %>
                  <% if (badgeClass) { %>
                    <span class="badge <%= badgeClass %>"><%= displayVal %></span>
                  <% } else { %>
                    <%= displayVal != null ? displayVal : '—' %>
                  <% } %>
                </td>
              <% }); %>
              <td class="actions-col">
                <div class="btn-group">
                  <% if (resourceId === 'tickets') { %>
                    <a href="/admin/resources/tickets/<%= record.id %>/show" class="btn btn-sm">Ver</a>
                  <% } else { %>
                    <a href="/admin/resources/<%= resourceId %>/<%= record.id %>" class="btn btn-sm">Ver</a>
                  <% } %>
                  <% if (editFields && editFields.length > 0) { %>
                    <a href="/admin/resources/<%= resourceId %>/<%= record.id %>/edit" class="btn btn-sm">Editar</a>
                  <% } %>
                  <% if (resourceId === 'projects') { %>
                    <a href="/admin/projects/<%= record.id %>/reports" class="btn btn-sm btn-primary">Relatórios</a>
                  <% } %>
                  <button class="btn btn-sm btn-danger" onclick="deleteRecord('<%= resourceId %>', <%= record.id %>)">Apagar</button>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- PAGINAÇÃO -->
<% if (totalPages > 1) { %>
<div class="pagination">
  <span>Mostrando <%= ((currentPage - 1) * perPage) + 1 %>–<%= Math.min(currentPage * perPage, total) %> de <%= total %></span>
  <div class="pages">
    <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %><%= filterQuery %>">&laquo;</a>
    <% } %>
    <% for (var p = 1; p <= totalPages; p++) { %>
      <% if (p === currentPage) { %>
        <span class="current"><%= p %></span>
      <% } else if (Math.abs(p - currentPage) < 3 || p === 1 || p === totalPages) { %>
        <a href="?page=<%= p %><%= filterQuery %>"><%= p %></a>
      <% } else if (Math.abs(p - currentPage) === 3) { %>
        <span>…</span>
      <% } %>
    <% } %>
    <% if (currentPage < totalPages) { %>
      <a href="?page=<%= currentPage + 1 %><%= filterQuery %>">&raquo;</a>
    <% } %>
  </div>
</div>
<% } %>

<script>
async function deleteRecord(resource, id) {
  if (!confirm('Tem certeza que deseja remover este registro?')) return;
  try {
    var resp = await fetch('/admin/api/' + resource + '/' + id, { method: 'DELETE' });
    if (resp.ok) { window.location.reload(); }
    else { var data = await resp.json(); alert(data.message || 'Erro ao apagar.'); }
  } catch (err) { alert('Erro ao apagar registro.'); }
}
</script>
