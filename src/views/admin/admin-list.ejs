<% var pageTitle=resourceLabel,activeMenu=resourceId,statusLabels=(fieldOptions&&fieldOptions.status)||[],priorityLabels=(fieldOptions&&fieldOptions.priority)||[],labels={};statusLabels.concat(priorityLabels,(fieldOptions&&fieldOptions.role)||[],(fieldOptions&&fieldOptions.order)||[]).forEach(function(x){labels[x.value]=x.label});function display(record,field){var value=record[field];if(field.endsWith('Id')||['userId','clientId','projectId'].includes(field)){var key=field.replace(/Id$/,''),name=key.charAt(0).toUpperCase()+key.slice(1);if(record[name]?.name)value=record[name].name;else if(record[key]?.name)value=record[key].name}if(field==='user_id'&&record.User)value=record.User.name;if(field==='client_id'&&record.Client)value=record.Client.name;if(field==='project_id'&&record.Project)value=record.Project.name;if(field==='ticket_id'&&record.Ticket)value=record.Ticket.title;if(['createdAt','updatedAt','due_date'].includes(field)&&value){var d=new Date(value);return d.toLocaleDateString('pt-BR')+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}return labels[value]||value||'—'}function badge(field,value){if(!['status','priority'].includes(field))return'';if(['active','done','approved','closed'].includes(value))return'badge-success';if(['pending','in_progress','doing','medium'].includes(value))return'badge-warning';if(['open','low','backlog'].includes(value))return'badge-info';if(['archived','rejected','inactive','high'].includes(value))return'badge-danger';return'badge-secondary'} %><div class="page-header"><div><h1 class="page-title"><%=resourceLabel%></h1><p class="page-subtitle"><%=total%> registros encontrados</p></div><div class="btn-group"><%if(statusLabels.length){%><a class="btn btn-sm" href="/admin/resources/<%=resourceId%>">Kanban</a><%}%><%if(editFields&&editFields.length){%><a class="btn btn-primary" href="/admin/resources/<%=resourceId%>/new">+ Criar novo</a><%}%></div></div><%if(statusLabels.length||priorityLabels.length){%><form class="card filters-row" method="GET"><%if(statusLabels.length){%><label>Status<select name="filter.status"><option value="">Todos</option><%statusLabels.forEach(function(x){%><option value="<%=x.value%>" <%=currentFilters['filter.status']===x.value?'selected':''%>><%=x.label%></option><%})%></select></label><%}%><%if(priorityLabels.length){%><label>Prioridade<select name="filter.priority"><option value="">Todas</option><%priorityLabels.forEach(function(x){%><option value="<%=x.value%>" <%=currentFilters['filter.priority']===x.value?'selected':''%>><%=x.label%></option><%})%></select></label><%}%><button class="btn btn-primary btn-sm">Filtrar</button><a class="btn btn-sm" href="/admin/resources/<%=resourceId%>?view=list">Limpar</a></form><%}%><div class="card"><div class="table-wrapper"><table class="admin-table"><thead><tr><%listFields.forEach(function(f){%><th><%=fieldLabels[f]||f%></th><%})%><th>Ações</th></tr></thead><tbody><%if(!records.length){%><tr><td colspan="<%=listFields.length+1%>"><div class="empty-state">Nenhum registro encontrado</div></td></tr><%}records.forEach(function(r){%><tr><%listFields.forEach(function(f){var c=badge(f,r[f]);%><td><%if(c){%><span class="badge <%=c%>"><%=display(r,f)%></span><%}else{%><%=display(r,f)%><%}%></td><%})%><td><div class="btn-group"><a class="btn btn-sm" href="<%=resourceId==='tickets'?'/admin/resources/tickets/'+r.id+'/show':'/admin/resources/'+resourceId+'/'+r.id%>">Ver</a><%if(editFields&&editFields.length){%><a class="btn btn-sm" href="/admin/resources/<%=resourceId%>/<%=r.id%>/edit">Editar</a><%}%><%if(resourceId==='projects'){%><a class="btn btn-sm btn-primary" href="/admin/projects/<%=r.id%>/reports">Relatórios</a><%}%><button type="button" class="btn btn-sm btn-danger js-delete-record" data-resource="<%=resourceId%>" data-id="<%=r.id%>">Apagar</button></div></td></tr><%})%></tbody></table></div></div><%if(totalPages>1){%><nav class="pagination"><span>Página <%=currentPage%> de <%=totalPages%></span><div class="pages"><%if(currentPage>1){%><a href="?page=<%=currentPage-1%><%=filterQuery%>">&laquo;</a><%}for(var p=1;p<=totalPages;p++){if(p===currentPage){%><span class="current"><%=p%></span><%}else if(Math.abs(p-currentPage)<3||p===1||p===totalPages){%><a href="?page=<%=p%><%=filterQuery%>"><%=p%></a><%}}if(currentPage<totalPages){%><a href="?page=<%=currentPage+1%><%=filterQuery%>">&raquo;</a><%}%></div></nav><%}%><script>document.querySelectorAll('.js-delete-record').forEach(function(button){button.addEventListener('click',async function(){if(!confirm('Tem certeza que deseja remover este registro?'))return;try{var response=await fetch('/admin/api/'+button.dataset.resource+'/'+button.dataset.id,{method:'DELETE'});if(response.ok)return location.reload();var data=await response.json();alert(data.message||'Erro ao apagar.')}catch(error){alert('Erro ao apagar registro.')}})});</script>
