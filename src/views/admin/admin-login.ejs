<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Kakau Tech Admin</title>
    <link rel="icon" type="image/webp" href="/public/favicon.webp" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #0d1b2a 0%, #152238 40%, #0c5e84 100%);
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
        -webkit-font-smoothing: antialiased;
      }

      .login-wrapper {
        display: flex;
        max-width: 1000px;
        width: 100%;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        animation: slideUp 0.5s ease;
      }

      @keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* LEFT — Branding */
      .login-branding {
        background: linear-gradient(180deg, #1187BD 0%, #0c5e84 100%);
        color: #fff;
        padding: 60px 48px;
        width: 42%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }
      .login-branding::before {
        content: ''; position: absolute;
        top: -40%; right: -30%; width: 300px; height: 300px;
        border-radius: 50%; background: rgba(255,255,255,0.08);
      }
      .login-branding::after {
        content: ''; position: absolute;
        bottom: -30%; left: -20%; width: 200px; height: 200px;
        border-radius: 50%; background: rgba(255,255,255,0.06);
      }
      .login-branding h2 { font-size: 30px; font-weight: 700; margin-bottom: 12px; letter-spacing: -0.3px; position: relative; z-index: 1; }
      .login-branding p { font-size: 15px; opacity: 0.8; line-height: 1.6; position: relative; z-index: 1; }
      .login-branding .brand-features { margin-top: 40px; position: relative; z-index: 1; }
      .login-branding .brand-features .feature { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; font-size: 14px; opacity: 0.85; }
      .login-branding .brand-features .feature-icon { width: 32px; height: 32px; border-radius: 8px; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }

      /* RIGHT — Form */
      .login-form-wrapper {
        padding: 60px 48px;
        width: 58%;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .login-form-wrapper .logo { display: block; max-width: 140px; margin: 0 auto 36px auto; }

      .form-group { margin-bottom: 20px; }
      .form-group label { display: block; font-weight: 600; margin-bottom: 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.8px; color: #555e68; }
      .form-group input { width: 100%; padding: 12px 16px; border: 1.5px solid #dee2e6; border-radius: 10px; font-size: 15px; font-family: inherit; color: #343a40; transition: all 0.2s; }
      .form-group input:focus { outline: none; border-color: #1187BD; box-shadow: 0 0 0 4px rgba(17,135,189,0.12); }

      .btn-submit { width: 100%; background: #1187BD; color: #fff; padding: 13px; border: none; border-radius: 50px; font-size: 15px; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; margin-top: 8px; }
      .btn-submit:hover { background: #0e6a94; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(17,135,189,0.3); }

      .error-message { color: #c23b33; background: #fde8e8; border: 1px solid #f5c6cb; border-radius: 12px; padding: 14px 16px; margin-bottom: 20px; text-align: center; font-size: 14px; font-weight: 500; animation: slideDown 0.3s ease; }
      @keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

      .social-login-divider { text-align: center; margin: 24px 0; position: relative; }
      .social-login-divider span { background: #fff; padding: 0 15px; position: relative; z-index: 1; color: #adb5bd; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
      .social-login-divider::before { content: ""; position: absolute; top: 50%; left: 0; width: 100%; height: 1px; background: #e9ecef; z-index: 0; }

      /* Botões sociais lado a lado */
      .social-buttons { display: flex; gap: 10px; }
      .btn-social {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        font-size: 13px;
        border: 1.5px solid #dee2e6;
        transition: all 0.2s;
        color: #495057;
        background: #fff;
        font-family: inherit;
        white-space: nowrap;
      }
      .btn-social:hover { background: #f8f9fa; border-color: #adb5bd; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
      .btn-social img { width: 18px; height: 18px; flex-shrink: 0; }

      @media (max-width: 900px) {
        .login-wrapper { flex-direction: column; max-width: 480px; }
        .login-branding { display: none; }
        .login-form-wrapper { width: 100%; padding: 36px 28px; }
        .social-buttons { flex-direction: column; }
        .btn-social { justify-content: center; }
      }

      @media (max-width: 480px) {
        .btn-social .btn-social-label { display: none; }
        .social-buttons { flex-direction: row; }
        .btn-social { flex: 1; min-width: 0; }
      }
    </style>
  </head>
  <body>
    <div class="login-wrapper">
      <!-- BRANDING -->
      <div class="login-branding">
        <h2>Área do Administrador</h2>
        <p>Painel de Controle Kakau Tech</p>
        <div class="brand-features">
          <div class="feature"><div class="feature-icon">📊</div><span>Dashboard em tempo real</span></div>
          <div class="feature"><div class="feature-icon">📋</div><span>Gestão de projetos e tarefas</span></div>
          <div class="feature"><div class="feature-icon">🎫</div><span>Controle de chamados</span></div>
          <div class="feature"><div class="feature-icon">📈</div><span>Relatórios completos</span></div>
        </div>
      </div>

      <!-- FORM -->
      <div class="login-form-wrapper">
        <img src="/public/kakau.webp" alt="Logo Kakau Tech" class="logo" />

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="error-message"><%= error %></div>
        <% } %>

        <!-- Botões sociais lado a lado: Google + Microsoft -->
        <div class="social-buttons">
          <a href="/admin/auth/google" class="btn-social">
            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" />
            <span class="btn-social-label">Google</span>
          </a>
          <a href="/admin/auth/microsoft" class="btn-social">
            <!-- Ícone Microsoft SVG inline — sem dependência externa -->
            <svg width="18" height="18" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="0"  y="0"  width="10" height="10" fill="#F25022"/>
              <rect x="11" y="0"  width="10" height="10" fill="#7FBA00"/>
              <rect x="0"  y="11" width="10" height="10" fill="#00A4EF"/>
              <rect x="11" y="11" width="10" height="10" fill="#FFB900"/>
            </svg>
            <span class="btn-social-label">Microsoft</span>
          </a>
        </div>

        <div class="social-login-divider">
          <span>OU</span>
        </div>

        <form action="/admin/login" method="POST">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="admin@kakautech.com" required />
          </div>
          <div class="form-group">
            <label for="password">Senha</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required />
          </div>
          <button type="submit" class="btn-submit">Entrar</button>
        </form>
      </div>
    </div>
  </body>
</html>
